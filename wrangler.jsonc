{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "runjs",
  "compatibility_date": "2025-02-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  },
  "pages_build_output_dir": "./dist",
  "observability": {
    "enabled": true
  }
}
