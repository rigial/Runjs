{
  "name": "runjs",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "vite --host",
    "sitemap": "python3 scripts/generate_sitemap.py",
    "build": "python3 scripts/generate_sitemap.py && tsc -b && vite build",
    "lint": "eslint ./src",
    "pretty": "prettier --write ./src",
    "preview": "vite preview",
    "check": "npm run pretty && npm run lint",
    "pages:dev": "wrangler pages dev ./dist",
    "pages:deploy": "pnpm run build && wrangler pages deploy ./dist",
    "worker:dev": "wrangler dev",
    "worker:deploy": "pnpm run build && wrangler deploy",
    "deploy": "pnpm run pages:deploy"
  },
  "dependencies": {
    "@codesandbox/sandpack-react": "^2.20.0",
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "emmet-monaco-es": "^5.5.0",
    "esbuild-wasm": "^0.27.0",
    "idb": "^8.0.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.34.0",
    "luna-console": "^1.3.5",
    "luna-object-viewer": "^0.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "react-split": "^2.0.14",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.4.0",
    "eslint-plugin-react-hooks": "^6.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.13.0",
    "prettier": "3.5.3",
    "rollup-plugin-visualizer": "^5.13.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.18.1",
    "vite": "^7.3.1",
    "wrangler": "^4.127.0"
  }
}
